    "insert_after": "produced_qty",
    "read_only": 1,
    "module": "KDV Bedding"
  },
  {
    "doctype": "Custom Field",
    "dt": "Work Order",
    "fieldname": "custom_cycle_time_days",
    "fieldtype": "Float",
    "label": "Cycle Time (Days)",
    "insert_after": "custom_production_efficiency",
    "read_only": 1,
    "module": "KDV Bedding"
  },
  {
    "doctype": "Custom Field",
    "dt": "Customer",
    "fieldname": "custom_sage_account_code",
    "fieldtype": "Data",
    "label": "Sage Account Code",
    "insert_after": "customer_name",
    "search_index": 1,
    "module": "KDV Bedding"
  },
  {
    "doctype": "Custom Field",
    "dt": "Supplier",
    "fieldname": "custom_sage_account_code",
    "fieldtype": "Data",
    "label": "Sage Account Code",
    "insert_after": "supplier_name",
    "search_index": 1,
    "module": "KDV Bedding"
  }
]
